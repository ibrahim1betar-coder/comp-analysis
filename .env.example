# Copy to .env (or export in your shell) and adjust.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database lives (created automatically).
DB_PATH=./data/competitor-pulse.db

# Login. On first start an admin account is created: username ADMIN_USERNAME (default "admin")
# with password ADMIN_PASSWORD (default "admin123", flagged to be changed after the first sign-in).
# Users are managed afterwards inside the app (Connect → Users & access).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to 1 to run without any login (local use only).
AUTH_DISABLED=0

# Encrypts platform API credentials at rest. If empty, a random key is generated once
# and stored in ./data/.secret. Set it explicitly when deploying to more than one machine.
APP_SECRET=

# Background collection
SYNC_INTERVAL_MINUTES=360     # how often every account is re-collected (0 disables the scheduler)
SYNC_CONCURRENCY=3            # accounts collected in parallel
LOOKBACK_DAYS=90              # how far back to collect posts on the first sync
POSTS_PER_ACCOUNT=300         # cap per account per sync

# Set to 1 to allow the public internet to call /api/import without login (not recommended).
# ALLOW_ANON_IMPORT=0
