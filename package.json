{
  "name": "competitor-pulse",
  "version": "1.0.0",
  "description": "Competitor social media analysis dashboard: collects interactions and video views across YouTube, Instagram, Facebook, TikTok and X and analyses them in one place.",
  "type": "module",
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning server/seed.js",
    "sync": "node --no-warnings=ExperimentalWarning server/cli-sync.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "chart.js": "^4.6.1",
    "fastify": "^5.12.8"
  }
}
